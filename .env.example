# Copy to .env; set strong values before first start.
PORT=8105
PUBLIC_SITE_URL=https://kitchensprayexpert.co.uk
# IMPORTANT: leave true for toastercabs / test deployments.
PREVIEW_MODE=true
ADMIN_PASSWORD=
SESSION_SECRET=
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Cloudflare Turnstile. Both values must be configured together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
